# TRON Guard watcher bot runtime.
# This is a different bot from HERMES_TELEGRAM_BOT_TOKEN in the stack root .env.
BOT_TOKEN=123456789:replace_with_tron_guard_watcher_bot_token

# Database from inside the Hermes container.
DATABASE_URL=postgres://tron:tron@postgres:5432/tron_watch

# TronScan / TRON APIs.
TRONSCAN_API_KEY=replace_with_tronscan_api_key
TRONSCAN_BASE_URL=https://apilist.tronscanapi.com
TRON_FULL_NODE_BASE_URL=https://api.trongrid.io
TRON_FULL_NODE_API_KEY=

# Telegram IDs for service admin HIGH/CRITICAL alerts from the watcher bot.
SERVICE_ADMIN_TG_IDS=123456789

# Runtime tuning.
POLL_INTERVAL_MS=30000
TRONSCAN_PAGE_LIMIT=50
TRONSCAN_MAX_PAGES_PER_WALLET=5
TRONSCAN_TIMEOUT_MS=10000
TRONSCAN_RETRY_ATTEMPTS=3
TRONSCAN_RETRY_BASE_DELAY_MS=500
TRONSCAN_BACKFILL_LOOKBACK_MS=86400000
TRONSCAN_REQUEST_MIN_INTERVAL_MS=100
TRONSCAN_RATE_LIMIT_COOLDOWN_MS=30000

