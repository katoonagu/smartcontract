{
  "name": "tron-usdt-monitoring-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "safety:recheck": "tsx scripts/safetyRecheck.ts",
    "forensic:route": "node --import tsx scripts/forensicRouteSearch.ts",
    "forensic:index": "node --import tsx scripts/indexTronUsdtEvents.ts",
    "forensic:beam": "node --import tsx scripts/forensicLocalBeamSearch.ts",
    "forensic:operational": "node --import tsx scripts/forensicOperationalReport.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.33.0",
    "pg": "^8.13.1",
    "tronweb": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "axios": "^1.16.1",
    "ws": "^8.20.1"
  }
}
